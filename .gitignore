# Xcode
build/
DerivedData/
.build/
*.xcuserstate
*.xcuserdatad/
xcuserdata/
*.moved-aside
*.hmap
*.ipa
*.dSYM.zip
*.dSYM

# SwiftPM
# Package.resolved IS committed: DesignLibrary is pinned by branch with no tags, so the
# resolved file is the only record of the revision this app was built against.
# NOTE: `Packages/` is NOT ignored — it holds the local ForageCatalogue package source.
.swiftpm/

# macOS
.DS_Store

# Evaluation photos: openly-licensed test data, fetched on demand, never shipped.
.eval-photos/
.eval-photos-negative/
.staged-photos/

# PyCharm: keep the shared run configurations, ignore the per-machine rest.
# The `**/` matters: a pattern containing a slash is anchored to this file's directory, so
# a bare `.idea/*` missed the one PyCharm creates when Tools/ is opened on its own.
**/.idea/*
!**/.idea/runConfigurations/
.venv/

# Python bytecode
__pycache__/
